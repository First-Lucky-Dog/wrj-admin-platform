# 开发环境：本地只启动前端项目，依赖开发环境（后端、APP）
NODE_ENV=production

VITE_DEV=true

# 请求路径
VITE_BASE_URL='http://api-dashboard.yudao.iocoder.cn'

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=false

# 是否删除console.log
VITE_DROP_CONSOLE=false

# 是否sourcemap
VITE_SOURCEMAP=true

# 打包路径
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist

# 商城H5会员端域名
VITE_MALL_H5_DOMAIN='http://mall.yudao.iocoder.cn'

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=true

# GoView域名
VITE_GOVIEW_URL='http://127.0.0.1:3000'

# 全球视角切换高度（米）
VITE_GLOBE_SWITCH_HEIGHT=2500000

# 全球视角适配高度（米）
VITE_GLOBE_FIT_HEIGHT=22000000

# 是否启用太空背景
VITE_ENABLE_SPACE_SKY=true

# 天地图请求并发控制
VITE_TDT_MAX_REQUESTS_PER_SERVER=3
VITE_TDT_MAX_REQUESTS=12

# 天地图注记层显示与限流保护
VITE_TDT_LABEL_VISIBLE_MAX_HEIGHT=500000
VITE_TDT_LABEL_MIN_LEVEL=8
VITE_TDT_LABEL_COOLDOWN_MS=60000
VITE_TDT_LABEL_ERROR_LOG_INTERVAL_MS=15000

# 全球视角双阈值（滞回，防止 near/global 抖动切换）
VITE_GLOBE_SWITCH_ENTER_HEIGHT=2600000
VITE_GLOBE_SWITCH_EXIT_HEIGHT=2300000
